# LLM Provider — set ONE (llama.cpp has highest priority):

# Option A: Local llama.cpp server (recommended, no API key, no rate limits)
LLAMA_CPP_URL=http://localhost:8080

# Option B: Google Gemini (cloud, requires API key from ai.google.dev)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Option C: Ollama (local fallback, used if neither A nor B is configured)
# LLM_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434

# --- CORS ---
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app

# --- PDF table extraction (Camelot) ---
# Path to the Ghostscript bin/ folder, only needed if it's not on PATH.
# Example Windows: C:\Program Files\gs\gs10.07.0\bin
# GHOSTSCRIPT_BIN=
